{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@LOGO@",
        "color": { "1": "#a78bfa", "2": "#f472b6", "3": "#a6f28a", "4": "#f472b6", "5": "#a6f28a", "6": "#a78bfa" },
        "padding": { "top": 1, "left": 1 }
    },
    "display": { "separator": "  " },
    "modules": [
        "title", "separator",
        "os", "host", "kernel", "uptime", "packages",
        "shell", "de", "wm", "terminal", "terminalfont",
        "cpu", "gpu", "memory", "disk", "localip", "battery",
        "break",
        "colors"
    ]
}
